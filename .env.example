# Mars Terraform — przykładowa konfiguracja (T15: bez kont, bazy i sekretów).
# Skopiuj do `.env` (plik ignorowany przez git) i uzupełnij wartości.
# NIGDY nie commituj prawdziwych sekretów. Klucze backendu: src_backend/config.ts.

# --- Serwer -----------------------------------------------------------------
# Port HTTP backendu (domyślnie 3000; akceptowany także `port`).
PORT=3000

# --- Serwer gry (D19) --------------------------------------------------------
# Produkcja to sam frontend w przeglądarce (bez API). Serwer Node działa lokalnie (dev),
# a w przyszłości gracz może uruchomić własny albo połączyć się z serwerem Mars Terraform.
# Bazowy URL API dla builda frontendu. Pusty = ścieżki względne `/api` (proxy Vite w dev).
VITE_API_URL=
# Allowlista originów CORS (CSV). Pusta = CORS wyłączony (same-origin).
cors_origins=
# Czy backend serwuje zbudowany frontend z `dist/` (true = całość z jednego serwera, false = API-only).
serve_frontend=true
