# Mars Terraform — przykładowa konfiguracja backendu/frontendu.
# Skopiuj do `.env` (plik ignorowany przez git) i uzupełnij wartości.
# NIGDY nie commituj prawdziwych sekretów. Klucze backendu: src_backend/config.ts.

# --- Wymagane ---------------------------------------------------------------
# Sekret do podpisywania JWT (długi, losowy ciąg; np. `openssl rand -hex 32`).
jwt_secret=
# T13: klucz HMAC numerów kont i szyfrowania sekretów TOTP (min. 32 znaki, np. `openssl rand -hex 48`).
# NIGDY nie zmieniaj na produkcji: zmiana unieważnia wszystkie numery kont.
account_secret=

# --- Serwer -----------------------------------------------------------------
# Port HTTP backendu (domyślnie 3000; akceptowany także `port`).
PORT=3000

# --- Baza danych (libsql / Turso) -------------------------------------------
# Lokalnie plik SQLite; w produkcji `libsql://<baza>.turso.io`.
turso_url=file:./local.db
# Token Turso (pusty dla lokalnego pliku).
turso_token=

# --- Auth (T13: numer konta + opcjonalny TOTP; bez e-maila, hasła i OAuth) ---
jwt_expires_in=1h

# --- AI (asystent generatora map) -------------------------------------------
openrouter_api_key=

# --- Deploy (Faza 8) --------------------------------------------------------
# Bazowy URL API dla builda frontendu (Vercel). Pusty = ścieżki względne `/api`.
# Produkcja: https://api.<domena> (bez końcowego `/`).
VITE_API_URL=
# Allowlista originów CORS (CSV). Pusta = CORS wyłączony (monolit same-origin).
cors_origins=
# Czy backend serwuje zbudowany frontend z `dist/` (true = monolit, false = API-only).
serve_frontend=true
