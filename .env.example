# Mars Terraform — przykładowa konfiguracja (T15: bez kont, bazy i sekretów).
# Skopiuj do `.env` (plik ignorowany przez git) i uzupełnij wartości.
# NIGDY nie commituj prawdziwych sekretów. Klucze backendu: src_backend/config.ts.

# --- Serwer -----------------------------------------------------------------
# Port HTTP backendu (domyślnie 3000; akceptowany także `port`).
PORT=3000

# --- Deploy (Faza 8) --------------------------------------------------------
# Bazowy URL API dla builda frontendu (Vercel). Pusty = ścieżki względne `/api`.
# Produkcja: https://api.<domena> (bez końcowego `/`).
VITE_API_URL=
# Allowlista originów CORS (CSV). Pusta = CORS wyłączony (monolit same-origin).
cors_origins=
# Czy backend serwuje zbudowany frontend z `dist/` (true = monolit, false = API-only).
serve_frontend=true
