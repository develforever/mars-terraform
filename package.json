{
  "name": "mars-terraform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:front": "vite",
    "dev:back": "tsx watch --inspect --tsconfig src_backend/tsconfig.json src_backend/index.ts",
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "build:back": "vite build -c vite.config.backend.ts",
    "build": "npm run build:back && tsc -b && vite build",
    "start": "node dist_backend/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:front": "vitest run",
    "test:back": "vitest run -c vitest.config.backend.ts",
    "test": "npm run test:front && npm run test:back",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "tsoa:routes": "tsoa routes",
    "tsoa:spec": "tsoa spec",
    "tsoa:gen": "tsoa spec-and-routes",
    "repomix": "npx repomix"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "@redux-devtools/extension": "^3.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tursodatabase/database": "^0.5.3",
    "@types/three": "^0.180.0",
    "bcrypt": "^6.0.0",
    "dotenv-flow": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "i18next": "^26.3.0",
    "jsonwebtoken": "^9.0.3",
    "postprocessing": "6.39.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-router": "^7.13.1",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.2.1",
    "three": "^0.180.0",
    "tsoa": "^7.0.0-alpha.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tsoa/cli": "^7.0.0-alpha.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.18.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "sass": "^1.93.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.5"
  }
}
